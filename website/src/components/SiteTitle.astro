---
// Header wordmark: lowercase "sigcull" in the self-hosted brand font (Climate
// Crisis), instead of the detailed portrait logo, which reads too small and busy
// squeezed into the nav bar. The full logo lives on the splash hero. No <img>
// here, so the Astro image audit has nothing to flag.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">{siteTitle}</a>

<style>
  .site-title {
    /* Climate Crisis is a single-weight eroded display face; keep it lowercase
       and a touch larger so the melted glyphs stay legible in the nav. */
    font-family: var(--font-brand), sans-serif;
    font-weight: 400;
    font-size: 1.4rem;
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
</style>
